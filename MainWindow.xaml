<Window x:Class="SmartEMobilityHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartEMobilityHub"
        mc:Ignorable="d"
        Title="Smart E-Mobility Hub – Student App (Demo)" Height="940" Width="900"
        WindowStartupLocation="CenterScreen" Background="#E2E8F0">
    <Viewbox Stretch="Uniform">
        <Grid Width="840" Height="900" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="410" Height="868" CornerRadius="44" Background="#0F172A" Padding="10" VerticalAlignment="Top">
                <Border x:Name="PhoneHost" Width="390" Height="848" CornerRadius="34" ClipToBounds="True" Background="White"/>
            </Border>
            <Border x:Name="DemoPanelHost" Grid.Column="1" Margin="16,0,0,0" Background="White" CornerRadius="12" Padding="14"/>
        </Grid>
    </Viewbox>
</Window>
