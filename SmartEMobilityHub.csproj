<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <!-- Hai project con nằm trong repo nên phải loại khỏi glob mặc định của app WPF. -->
  <ItemGroup>
    <Compile Remove="src/**" />
    <Compile Remove="tests/**" />
    <Page Remove="src/**" />
    <Page Remove="tests/**" />
    <ApplicationDefinition Remove="src/**" />
    <ApplicationDefinition Remove="tests/**" />
  </ItemGroup>

  <!-- Dùng chung AuthService và tài khoản demo với Trung tâm điều hành. -->
  <ItemGroup>
    <ProjectReference Include="src/SmartEMobilityHub.Core/SmartEMobilityHub.Core.csproj" />
  </ItemGroup>

</Project>
