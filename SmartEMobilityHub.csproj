<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <!-- Hai project con nằm trong repo nên phải loại khỏi glob mặc định của app WPF. -->
  <ItemGroup>
    <Compile Remove="src/**" />
    <Compile Remove="tests/**" />
    <Page Remove="src/**" />
    <Page Remove="tests/**" />
    <ApplicationDefinition Remove="src/**" />
    <ApplicationDefinition Remove="tests/**" />
  </ItemGroup>

  <!-- ShotKit (chụp màn hình cho Working demonstration) chỉ có một bản, nằm ở project Operator;
       app Sinh viên biên dịch chung file đó thay vì giữ bản sao (DC-49). -->
  <ItemGroup>
    <Compile Include="src/SmartEMobilityHub.Operator/Capture/ShotKit.cs" Link="Capture/ShotKit.cs" />
  </ItemGroup>

  <!-- Dùng chung Core (AuthService, mạng lưới) và mở được Trung tâm điều hành trong cùng tiến trình (chế độ liên thông). -->
  <ItemGroup>
    <ProjectReference Include="src/SmartEMobilityHub.Core/SmartEMobilityHub.Core.csproj" />
    <ProjectReference Include="src/SmartEMobilityHub.Operator/SmartEMobilityHub.Operator.csproj" />
  </ItemGroup>

</Project>
