<Window x:Class="SmartEMobilityHub.Operator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart E-Mobility Hub · Trung tâm điều hành"
        Height="940" Width="1520" MinHeight="760" MinWidth="1240"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Roboto, sans-serif"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Ô cổng sạc dùng ở trang Phương tiện & cổng sạc và trang Lịch sạc. -->
        <DataTemplate x:Key="PortTileTemplate">
            <Border Width="92" Height="58" CornerRadius="10" Margin="0,0,8,8" Padding="9,6"
                    Background="{Binding Background}" ToolTip="{Binding ToolTipText}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding NumberText}" FontSize="12" FontWeight="Bold" Foreground="{Binding Foreground}" />
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{Binding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding DetailText}" FontSize="10" Foreground="{Binding Foreground}" Opacity="0.85"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Padding="20,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0B1220" Offset="0" />
                    <GradientStop Color="#0F172A" Offset="0.55" />
                    <GradientStop Color="#172554" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0" />
                                <GradientStop Color="#6366F1" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Trung tâm điều hành" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Smart E-Mobility Hub · Khu đô thị ĐHQG-HCM · Nhóm 21"
                                   FontSize="11.5" Foreground="#94A3B8" />
                    </StackPanel>
                    <Border Background="#1A10B981" BorderBrush="#5510B981" BorderThickness="1" CornerRadius="11"
                            Padding="9,3" Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Đang giám sát" FontSize="11" Foreground="#6EE7B7" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClockText}" Foreground="White" FontSize="18"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <TextBlock Text="{Binding ScanText}" Foreground="#94A3B8" FontSize="11"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Click="Scan_Click" Margin="0,0,8,0" ToolTip="Chạy ngay một chu kỳ quét 6 bước">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Quét ngay" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="WhatIf_Click" Background="#6366F1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Mô phỏng What-if" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Background="#334155" Margin="16,4,16,4" />
                    <Border Width="34" Height="34" CornerRadius="17" Background="#1E3A8A" Margin="0,0,10,0">
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#BFDBFE"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="OperatorNameText" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="OperatorRoleText" Foreground="#94A3B8" FontSize="11" />
                    </StackPanel>
                    <Button x:Name="ThemeButton" Content="☾ Chế độ tối" Style="{StaticResource GhostButton}"
                            Click="Theme_Click" Margin="0,0,8,0" ToolTip="Đổi chế độ giao diện Sáng / Tối" />
                    <Button Content="Đăng xuất" Style="{StaticResource GhostButton}" Click="Logout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY: thanh bên + trang -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="14,18,14,14">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <TextBlock Text="CHU KỲ QUÉT" Style="{StaticResource Overline}" />
                            <TextBlock Text="{Binding ScanText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <CheckBox Style="{StaticResource ThemedCheckBox}" Content="Tự động quét (30 giây)" IsChecked="{Binding AutoScan}" FontSize="11.5" Margin="0,0,0,4" />
                            <CheckBox Style="{StaticResource ThemedCheckBox}" Content="Tăng tốc ×10" IsChecked="{Binding SpeedUp}" FontSize="11.5" />
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="ĐIỀU HÀNH" Style="{StaticResource Overline}" Margin="12,0,0,8" />
                        <ListBox ItemsSource="{Binding NavItems}" SelectedIndex="{Binding PageIndex, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource NavItem}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <Border Grid.Column="2" Background="{DynamicResource Primary}" CornerRadius="9" MinWidth="20" Padding="6,1"
                                                Visibility="{Binding BadgeVisibility}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="PHÂN TÍCH" Style="{StaticResource Overline}" Margin="12,14,0,8" />
                        <Button Click="WhatIf_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Text2}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Mô phỏng What-if" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" />
                                    <TextBlock Text="5 kịch bản · gợi ý điều phối" FontSize="10.5" Foreground="{DynamicResource Text2}" Opacity="0.8" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- PAGES -->
            <Grid Grid.Column="1">

                <!-- ===== Trang 0: Tổng quan mạng lưới ===== -->
                <Grid Margin="22,18,22,16" Visibility="{Binding OverviewVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tổng quan mạng lưới" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding NetworkSummaryText}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Rows="1" Columns="6" Margin="0,16,-12,16">
                        <Border Style="{StaticResource KpiTile}">
                            <StackPanel>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource SkySubtle}" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource SkyText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding KpiHubsText}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="Hub đang hoạt động" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding KpiHubsHint}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiTile}">
                            <StackPanel>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource EmeraldSubtle}" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE804;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource EmeraldText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding KpiVehiclesText}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="Xe sẵn sàng" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding KpiVehiclesHint}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiTile}">
                            <StackPanel>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource VioletSubtle}" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource VioletText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding KpiPortsText}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="Cổng sạc trống" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding KpiPortsHint}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiTile}">
                            <StackPanel>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource RoseSubtle}" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource RoseText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding OverloadText}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="Hub quá tải (≥ 90%)" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AtRiskHint}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiTile}">
                            <StackPanel>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AmberSubtle}" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AmberText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding KpiOpenIncidents}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="Sự cố đang mở" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding KpiNew, Mode=OneWay}" /><Run Text=" mới · " /><Run Text="{Binding KpiRepair, Mode=OneWay}" /><Run Text=" đang sửa" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiTile}">
                            <StackPanel>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AmberSubtle}" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AmberText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding AlertCountText}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="Cảnh báo gần đây" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                    <Run Text="KTV sẵn sàng " /><Run Text="{Binding TechText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="16,14,6,6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="Mạng lưới Mobility Hub" Style="{StaticResource H1}" />
                                        <TextBlock Text="Chỗ đỗ, cổng sạc và xe sẵn sàng tại từng Hub · bấm một Hub để xem chi tiết xe và cổng sạc" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="&lt; 80%" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                                        <Ellipse Width="8" Height="8" Fill="#EA580C" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="80–89%" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                                        <Ellipse Width="8" Height="8" Fill="#DC2626" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="≥ 90%" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Hubs}" Margin="0,0,10,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CardButton}" Tag="{Binding HubId}" Click="HubCard_Click"
                                                        BorderBrush="{Binding AccentBrush}" Margin="0,0,10,10">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                                                            <Border Style="{StaticResource Pill}" Background="{Binding StatusBackground}" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                                        <Grid Margin="0,10,0,4">
                                                            <TextBlock Text="Chỗ đỗ" FontSize="11.5" Foreground="{DynamicResource Text2}" />
                                                            <TextBlock Text="{Binding ParkingText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding ParkingBrush}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding ParkingPercent, Mode=OneWay}" Foreground="{Binding ParkingBrush}" />
                                                        <Grid Margin="0,8,0,4">
                                                            <TextBlock Text="Cổng đang sạc" FontSize="11.5" Foreground="{DynamicResource Text2}" />
                                                            <TextBlock Text="{Binding ChargingText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding ChargingBrush}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding ChargingPercent, Mode=OneWay}" Foreground="{Binding ChargingBrush}" />
                                                        <Grid Margin="0,10,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE804;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                <TextBlock Text="{Binding VehiclesText}" Style="{StaticResource Caption}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding FreeChargersText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Hub có nguy cơ quá tải" Style="{StaticResource H2}" />
                                    <TextBlock Text="{Binding AtRiskHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                    <ItemsControl ItemsSource="{Binding AtRiskHubs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CardButton}" Tag="{Binding HubId}" Click="HubCard_Click"
                                                        BorderBrush="{Binding AccentBrush}" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                                                            <TextBlock Text="{Binding LoadText}" Style="{StaticResource Caption}" />
                                                            <ProgressBar Style="{StaticResource Meter}" Value="{Binding ParkingPercent, Mode=OneWay}" Foreground="{Binding UtilizationBrush}" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding UtilizationText}" FontSize="18" FontWeight="Bold" Foreground="{Binding UtilizationBrush}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding RiskText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding UtilizationBrush}" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Visibility="{Binding AtRiskEmptyVisibility}" Margin="0,4,0,4" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource Success}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Mạng lưới đang cân bằng" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Cảnh báo gần đây" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,5">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11"
                                                       Margin="0,3,0,0" Foreground="{DynamicResource Text2}" />
                                            <TextBlock Text="{Binding DeliveryText}" FontSize="10.5"
                                                       Foreground="{Binding DeliveryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== Trang 1: Sự cố & bảo trì (UC-OP-03) ===== -->
                <Grid Margin="22,18,22,16" Visibility="{Binding IncidentsVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="370" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <Grid>
                                    <TextBlock Text="Sự cố &amp; Bảo trì" Style="{StaticResource H1}" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="10" Padding="8,3">
                                        <TextBlock Text="{Binding VisibleCountText}" Style="{StaticResource Caption}" />
                                    </Border>
                                </Grid>

                                <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                                         Style="{StaticResource ChipList}" Margin="0,10,0,6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" FontSize="12"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Tìm mã, thiết bị, lỗi hoặc Hub…"
                                         Style="{StaticResource SearchBox}" Margin="0,0,0,10" />
                            </StackPanel>
                    <ListBox ItemsSource="{Binding Incidents}"
                             SelectedItem="{Binding SelectedIncident, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource IncidentItem}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding PriorityBrush}" Width="4" CornerRadius="2"
                                            Margin="0,2,0,2" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <Grid>
                                            <TextBlock Text="{Binding Code}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text}" />
                                            <Border HorizontalAlignment="Right" Background="{Binding StatusBackground}"
                                                    CornerRadius="8" Padding="7,2">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                           Foreground="{Binding StatusForeground}" />
                                            </Border>
                                        </Grid>
