                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,2,0,0">
                            <StackPanel>
                                <TextBlock Text="Quy tắc ưu tiên (tổng = 1)" FontSize="11.5" FontWeight="SemiBold" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Pin thấp" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding WeightBatteryText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Sắp cần xe" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding WeightNeedTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Cao điểm" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding WeightPeakText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding WeightsInfoText}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Áp dụng" Style="{StaticResource PrimaryButton}"
                                            Click="ApplyWeights_Click" Margin="0,0,6,0" />
                                    <Button Content="Mặc định" Style="{StaticResource GhostButton}"
                                            Click="ResetWeights_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>


                                <Border Background="{DynamicResource PrimarySubtle}" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Mẹo vận hành" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                                        <TextBlock Text="• Chọn một yêu cầu đang chờ rồi Ghim lên/xuống để cố định thứ tự; yêu cầu đã ghim giữ chỗ khi lập lịch lại.&#x0a;• Cổng lỗi/offline không được cấp; xe đang sạc ở cổng lỗi được chuyển sang cổng khác."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Trang 4: Điều phối phương tiện ===== -->
                <Grid Margin="22,18,22,16" Visibility="{Binding DispatchVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Điều phối phương tiện" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Phát hiện Hub dư xe (≥ 85%) và thiếu xe (≤ 35%), gợi ý lệnh điều chuyển về mức mục tiêu 65%; chỉ dùng xe thật đang sẵn sàng." Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="16,14,6,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Cân bằng tải giữa các Hub" Style="{StaticResource H1}" Margin="0,0,0,10" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Hubs}" Margin="0,0,10,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                            <Border Style="{StaticResource Pill}" Background="{Binding ImbalanceBackground}" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding ImbalanceTag}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ImbalanceBrush}" />
                                                            </Border>
                                                        </Grid>
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ProgressBar Style="{StaticResource Meter}" Value="{Binding ParkingPercent, Mode=OneWay}" Foreground="{Binding ParkingBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ParkingText}" FontSize="11" Foreground="{DynamicResource Text2}" Margin="10,0,0,0" />
                                                        </Grid>
                                                        <Grid Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding VehiclesText}" Style="{StaticResource Caption}" />
                                                            <TextBlock Text="{Binding FreeSlotsText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Lệnh điều phối" Style="{StaticResource H1}" Margin="0,0,0,10" />
                                </StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="8" Padding="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Hub nguồn" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                        <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding HubIds}" SelectedItem="{Binding SourceHubId, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Hub đích" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                        <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding HubIds}" SelectedItem="{Binding TargetHubId, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Số xe" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding DispatchVehicleCountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nhân sự" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding DispatchStaffId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Gợi ý tự động" Style="{StaticResource GhostButton}"
                                            Click="SuggestDispatch_Click" Margin="0,0,6,6" />
                                    <Button Content="Tạo lệnh" Style="{StaticResource PrimaryButton}"
                                            Click="CreateDispatch_Click" Margin="0,0,6,6" />
                                    <Button Content="Xuất phát" Style="{StaticResource GhostButton}"
                                            Click="ExecuteDispatch_Click" IsEnabled="{Binding CanExecuteDispatch}" Margin="0,0,6,6" />
                                    <Button Content="Hoàn tất" Style="{StaticResource GhostButton}"
                                            Click="CompleteDispatch_Click" IsEnabled="{Binding CanCompleteDispatch}" Margin="0,0,0,6" />
                                </WrapPanel>

                                <ListBox ItemsSource="{Binding DispatchOrders}"
                                        SelectedItem="{Binding SelectedDispatchOrder, Mode=TwoWay}"
                                        HorizontalContentAlignment="Stretch"
                                        BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                                    BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding OrderId}" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding RouteText}" FontSize="11.5" FontWeight="SemiBold"
                                                                Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold"
                                                                Foreground="{Binding StatusBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding VehiclesText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>


</ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Trang 5: Kịch bản demo & nhật ký ===== -->
                <Grid Margin="22,18,22,16" Visibility="{Binding DemoVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Kịch bản demo &amp; nhật ký" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Giả lập sự kiện IoT và vận hành (không thuộc sản phẩm thật) để trình diễn các luồng ngoại lệ." Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Sự kiện thiết bị &amp; mạng" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2">
                                        <Button Style="{StaticResource GhostButton}" Click="BreakPort_Click" Margin="0,0,6,6" HorizontalContentAlignment="Left">
                                            <StackPanel><TextBlock Text="Cổng CS-08-08 lỗi" FontWeight="SemiBold" /><TextBlock Text="Cảm biến báo lỗi → sự cố + cảnh báo" Style="{StaticResource Caption}" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Click="DisconnectHub_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                            <StackPanel><TextBlock Text="Mất kết nối HUB-03" FontWeight="SemiBold" /><TextBlock Text="Hub và 4 cổng chuyển Offline" Style="{StaticResource Caption}" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Click="Stale_Click" Margin="0,0,6,6" HorizontalContentAlignment="Left">
                                            <StackPanel><TextBlock Text="Dữ liệu cũ HUB-08" FontWeight="SemiBold" /><TextBlock Text="Dữ liệu 14 phút → cảnh báo STALE" Style="{StaticResource Caption}" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Click="Unlock_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                            <StackPanel><TextBlock Text="Sự cố mở khoá" FontWeight="SemiBold" /><TextBlock Text="XE-121 không xác nhận mở khoá" Style="{StaticResource Caption}" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Click="BreakChannel_Click" Margin="0,0,6,6" HorizontalContentAlignment="Left">
                                            <StackPanel><TextBlock Text="Mạng cảnh báo lỗi" FontWeight="SemiBold" /><TextBlock Text="Cảnh báo vào hàng đợi gửi lại" Style="{StaticResource Caption}" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Click="RestoreChannel_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                            <StackPanel><TextBlock Text="Khôi phục &amp; gửi lại" FontWeight="SemiBold" /><TextBlock Text="Sau 30 giây gửi lại cảnh báo" Style="{StaticResource Caption}" /></StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <TextBlock Text="Thời gian mô phỏng" Style="{StaticResource H2}" Margin="0,14,0,8" />
                                    <WrapPanel>
                                        <Button Content="+1 phút" Style="{StaticResource GhostButton}" Click="Plus1_Click" Margin="0,0,6,6" />
                                        <Button Content="+5 phút" Style="{StaticResource GhostButton}" Click="Plus5_Click" Margin="0,0,6,6" />
                                        <Button Content="+15 phút" Style="{StaticResource GhostButton}" Click="Plus15_Click" Margin="0,0,6,6" />
                                        <Button Content="Đặt lại demo" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Danger}" Click="Reset_Click" Margin="0,0,6,6" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <CheckBox Style="{StaticResource ThemedCheckBox}" Content="Tự động quét" IsChecked="{Binding AutoScan}" FontSize="12" Margin="0,0,16,0" />
                                        <CheckBox Style="{StaticResource ThemedCheckBox}" Content="Tăng tốc ×10" IsChecked="{Binding SpeedUp}" FontSize="12" />
                                    </StackPanel>

                                    <TextBlock Text="Cảnh báo gần đây" Style="{StaticResource H2}" Margin="0,16,0,8" />
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,5">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11"
                                                       Margin="0,3,0,0" Foreground="{DynamicResource Text2}" />
                                            <TextBlock Text="{Binding DeliveryText}" FontSize="10.5"
                                                       Foreground="{Binding DeliveryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Nhật ký hệ thống" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <Border Background="{DynamicResource LogBg}" CornerRadius="10" Padding="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Logs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                               Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#0F172A" Padding="18,7">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding LastActionText}" Foreground="#E2E8F0" FontSize="11.5" />
                </StackPanel>
                <TextBlock Text="Nhóm 21 · CO3001 · Dữ liệu mô phỏng" Foreground="#64748B" FontSize="11"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
