<Window x:Class="SmartEMobilityHub.Operator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart E-Mobility Hub · Trung tâm điều hành"
        Height="940" Width="1520" MinHeight="760" MinWidth="1240"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBg}"
        FontFamily="Segoe UI, Roboto, sans-serif"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0F172A" Padding="22,13">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#2563EB">
                        <TextBlock Text="⚡" FontSize="19" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Trung tâm điều hành" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Smart E-Mobility Hub · Nhóm 21 · CO3001"
                                   FontSize="11.5" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Mô phỏng What-if" Style="{StaticResource PrimaryButton}"
                            Click="WhatIf_Click" Margin="0,0,12,0" />
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClockText}" Foreground="White" FontSize="17"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ScanText}" Foreground="#94A3B8" FontSize="11"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="Quét ngay" Style="{StaticResource PrimaryButton}" Click="Scan_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="385" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="365" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: danh sách sự cố -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="16,14,8,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <TextBlock Text="Sự cố &amp; Bảo trì" Style="{StaticResource H1}" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="10" Padding="8,3">
                                <TextBlock Text="{Binding VisibleCountText}" Style="{StaticResource Caption}" />
                            </Border>
                        </Grid>

                        <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                                 ItemContainerStyle="{StaticResource FilterItem}"
                                 BorderThickness="0" Background="Transparent" Margin="0,10,0,6">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBox}" Margin="0,0,0,10" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Incidents}"
                             SelectedItem="{Binding SelectedIncident, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource IncidentItem}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding PriorityBrush}" Width="4" CornerRadius="2"
                                            Margin="0,2,0,2" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <Grid>
                                            <TextBlock Text="{Binding Code}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text}" />
                                            <Border HorizontalAlignment="Right" Background="{Binding StatusBackground}"
                                                    CornerRadius="8" Padding="7,2">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                           Foreground="{Binding StatusForeground}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Text}" Margin="0,3,0,0" />
                                        <Grid Margin="0,5,0,0">
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding PriorityText}" FontSize="10.5"
                                                           FontWeight="SemiBold" Foreground="{Binding PriorityBrush}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding CreatedText}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- CENTER: chi tiết + hành động -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,14" Padding="18">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DetailVisibility}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedIncident.Title}" Style="{StaticResource H1}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedIncident.Meta}" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SelectedIncident.Id}" Style="{StaticResource Caption}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                            Margin="10,0,0,0">
                                    <Border Background="{Binding SelectedIncident.PriorityBrush}" CornerRadius="10"
                                            Padding="9,3" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedIncident.PriorityText}" Foreground="White"
                                                   FontSize="11" />
                                    </Border>
                                    <Border Background="{Binding SelectedIncident.StatusBackground}" CornerRadius="10"
                                            Padding="9,3">
                                        <TextBlock Text="{Binding SelectedIncident.StatusText}"
                                                   Foreground="{Binding SelectedIncident.StatusForeground}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedIncident.Description}" TextWrapping="Wrap"
                                               FontSize="12.5" Foreground="{StaticResource Text}" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}">
                                        <Run Text="Người báo: " />
                                        <Run Text="{Binding SelectedIncident.ReporterText, Mode=OneWay}" />
                                        <Run Text="  ·  Tạo: " />
                                        <Run Text="{Binding SelectedIncident.CreatedText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Khoá thiết bị" Style="{StaticResource PrimaryButton}"
                                        Click="Lock_Click" IsEnabled="{Binding CanLock}" Margin="0,0,8,8" />
                                <Button Content="Tạo phiếu bảo trì" Style="{StaticResource GhostButton}"
                                        Click="Task_Click" IsEnabled="{Binding CanCreateTask}" Margin="0,0,8,8" />
                                <Button Content="Gán KTV gần nhất" Style="{StaticResource GhostButton}"
                                        Click="Assign_Click" IsEnabled="{Binding CanAssign}" Margin="0,0,8,8" />
                                <Button Content="Hoàn tất xử lý" Style="{StaticResource GhostButton}"
                                        Click="Resolve_Click" IsEnabled="{Binding CanResolve}" Margin="0,0,8,8" />
                                <Button Content="Đóng sự cố" Style="{StaticResource GhostButton}"
                                        Click="Close_Click" IsEnabled="{Binding CanClose}" Margin="0,0,8,8" />
                                <Button Content="Tạm dừng Hub" Style="{StaticResource GhostButton}"
                                        Foreground="{StaticResource Danger}" Click="Suspend_Click"
                                        IsEnabled="{Binding CanSuspend}" Margin="0,0,0,8" />
                            </WrapPanel>

                            <TextBlock Text="Phiếu bảo trì" Style="{StaticResource H2}" Margin="0,12,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAlt}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TaskId}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding TechText}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding SlaText}" FontSize="11.5"
                                                               Foreground="{Binding SlaBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Nhật ký xử lý" Style="{StaticResource H2}" Margin="0,12,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedIncident.Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" />
                                            <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{StaticResource Primary}"
                                                     VerticalAlignment="Top" Margin="0,4,0,0" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
                                                <TextBlock Text="{Binding Actor}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding EmptyVisibility}">
                        <TextBlock Text="Chọn một sự cố ở cột bên trái" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" HorizontalAlignment="Center" />
                        <TextBlock Text="24 sự cố mẫu: 12 mới · 7 kiểm tra · 5 đang sửa"
                                   Style="{StaticResource Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: KPI, KTV, demo -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,14,16,14" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Tình trạng vận hành" Style="{StaticResource H1}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="#FEF3C7" CornerRadius="10"
                                    Padding="10" Margin="0,0,4,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding KpiNew}" FontSize="20" FontWeight="Bold" Foreground="#B45309" />
                                    <TextBlock Text="Mới" FontSize="11" Foreground="#92400E" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Background="#E0F2FE" CornerRadius="10"
                                    Padding="10" Margin="4,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding KpiCheck}" FontSize="20" FontWeight="Bold" Foreground="#0369A1" />
                                    <TextBlock Text="Kiểm tra / khoá" FontSize="11" Foreground="#075985" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Background="#EDE9FE" CornerRadius="10"
                                    Padding="10" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding KpiRepair}" FontSize="20" FontWeight="Bold" Foreground="#6D28D9" />
                                    <TextBlock Text="Đang sửa" FontSize="11" Foreground="#5B21B6" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Background="#D1FAE5" CornerRadius="10"
                                    Padding="10" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding KpiDone}" FontSize="20" FontWeight="Bold" Foreground="#047857" />
                                    <TextBlock Text="Đã xong" FontSize="11" Foreground="#065F46" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding OverloadText}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource Danger}" />
                                    <TextBlock Text="Hub quá tải" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding AlertCountText}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#B45309" />
                                    <TextBlock Text="Cảnh báo" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Kỹ thuật viên" Style="{StaticResource H2}" Margin="0,14,0,2" />
                        <TextBlock Text="{Binding TechText}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Technicians}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{Binding AvailableBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                            <TextBlock Text="{Binding Team}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding AvailableText}" FontSize="11" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding DistanceText}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Hàng chờ sạc HUB-08" Style="{StaticResource H2}" Margin="0,12,0,6" />
                        <ItemsControl ItemsSource="{Binding ChargingQueue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="66" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Vehicle}" FontSize="11.5" />
                                        <TextBlock Grid.Column="2" Text="{Binding BatteryText}" FontSize="11.5" />
                                        <TextBlock Grid.Column="3" Text="{Binding ScoreText}" FontSize="11.5"
                                                   Foreground="{StaticResource Primary}" />
                                        <TextBlock Grid.Column="4" Text="{Binding StatusText}" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Thêm 3 yêu cầu sạc" Style="{StaticResource GhostButton}"
                                Click="ChargeDemo_Click" Margin="0,6,0,0" HorizontalAlignment="Left" />

                        <TextBlock Text="Cảnh báo gần đây" Style="{StaticResource H2}" Margin="0,14,0,6" />
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                            BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,5">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11"
                                                       Margin="0,3,0,0" Foreground="{StaticResource Text2}" />
                                            <TextBlock Text="{Binding DeliveryText}" FontSize="10.5"
                                                       Foreground="{Binding DeliveryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Kịch bản demo" Style="{StaticResource H2}" Margin="0,14,0,6" />
                        <WrapPanel>
                            <Button Content="Cổng CS-08-08 lỗi" Style="{StaticResource GhostButton}"
                                    Click="BreakPort_Click" Margin="0,0,6,6" />
                            <Button Content="Mất kết nối HUB-03" Style="{StaticResource GhostButton}"
                                    Click="DisconnectHub_Click" Margin="0,0,6,6" />
                            <Button Content="Dữ liệu cũ HUB-08" Style="{StaticResource GhostButton}"
                                    Click="Stale_Click" Margin="0,0,6,6" />
                            <Button Content="Mạng cảnh báo lỗi" Style="{StaticResource GhostButton}"
                                    Click="BreakChannel_Click" Margin="0,0,6,6" />
                            <Button Content="Khôi phục &amp; gửi lại" Style="{StaticResource GhostButton}"
                                    Click="RestoreChannel_Click" Margin="0,0,6,6" />
                            <Button Content="Sự cố mở khoá" Style="{StaticResource GhostButton}"
                                    Click="Unlock_Click" Margin="0,0,6,6" />
                        </WrapPanel>

                        <WrapPanel Margin="0,2,0,0">
                            <Button Content="+1 phút" Style="{StaticResource GhostButton}"
                                    Click="Plus1_Click" Margin="0,0,6,6" />
                            <Button Content="+5 phút" Style="{StaticResource GhostButton}"
                                    Click="Plus5_Click" Margin="0,0,6,6" />
                            <Button Content="+15 phút" Style="{StaticResource GhostButton}"
                                    Click="Plus15_Click" Margin="0,0,6,6" />
                            <Button Content="Đặt lại demo" Style="{StaticResource GhostButton}"
                                    Click="Reset_Click" Margin="0,0,6,6" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <CheckBox Content="Tự động quét" IsChecked="{Binding AutoScan}" FontSize="11.5"
                                      VerticalAlignment="Center" Margin="0,0,14,0" />
                            <CheckBox Content="Tăng tốc ×10" IsChecked="{Binding SpeedUp}" FontSize="11.5"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Nhật ký hệ thống" Style="{StaticResource H2}" Margin="0,14,0,6" />
                        <Border Background="#0F172A" CornerRadius="8" Padding="8" MaxHeight="130">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"
                                                       Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#0F172A" Padding="18,7">
            <Grid>
                <TextBlock Text="{Binding LastActionText}" Foreground="#E2E8F0" FontSize="11.5" />
                <TextBlock Text="Nhóm 21 · CO3001 · Dữ liệu mô phỏng" Foreground="#64748B" FontSize="11"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
