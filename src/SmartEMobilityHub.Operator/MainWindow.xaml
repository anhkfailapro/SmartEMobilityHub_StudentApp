<Window x:Class="SmartEMobilityHub.Operator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartEMobilityHub.Operator.Views"
        Title="Smart E-Mobility Hub · Trung tâm điều hành"
        Height="940" Width="1520" MinHeight="760" MinWidth="1240"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Roboto, sans-serif"
        TextOptions.TextFormattingMode="Display">
    <Grid Background="{DynamicResource CanvasBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Padding="20,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0B1220" Offset="0" />
                    <GradientStop Color="#0F172A" Offset="0.55" />
                    <GradientStop Color="#172554" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <!-- Header 2 cột: bên trái co lại (tiêu đề phụ cắt "…") để không đè lên đồng hồ / nút bên phải
                 khi cửa sổ hẹp hơn 1520 (laptop, màn hình scale 125–150%). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,16,0" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0" />
                                <GradientStop Color="#6366F1" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Trung tâm điều hành" FontSize="18" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Smart E-Mobility Hub · Khu đô thị ĐHQG-HCM · Nhóm 21"
                                   FontSize="11.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"
                                   ToolTip="Smart E-Mobility Hub · Khu đô thị ĐHQG-HCM · Nhóm 21" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="#1A10B981" BorderBrush="#5510B981" BorderThickness="1" CornerRadius="11"
                            Padding="9,3" Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Đang giám sát" FontSize="11" Foreground="#6EE7B7" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClockText}" Foreground="White" FontSize="18"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <TextBlock Text="{Binding ScanText}" Foreground="#94A3B8" FontSize="11"
                                   HorizontalAlignment="Right" MaxWidth="190" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ScanText}" />
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0" ToolTip="Chạy ngay một chu kỳ quét 6 bước">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Quét ngay" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="WhatIf_Click" Background="#6366F1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Mô phỏng What-if" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Background="#334155" Margin="16,4,16,4" />
                    <Border Width="34" Height="34" CornerRadius="17" Background="#1E3A8A" Margin="0,0,10,0">
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#BFDBFE"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="OperatorNameText" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="OperatorRoleText" Foreground="#94A3B8" FontSize="11" />
                    </StackPanel>
                    <Button x:Name="ThemeButton" Content="☾ Chế độ tối" Style="{StaticResource GhostButton}"
                            Click="Theme_Click" Margin="0,0,8,0" ToolTip="Đổi chế độ giao diện Sáng / Tối" />
                    <Button Content="Đăng xuất" Style="{StaticResource GhostButton}" Click="Logout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY: thanh bên + trang -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="14,18,14,14">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <TextBlock Text="CHU KỲ QUÉT" Style="{StaticResource Overline}" />
                            <TextBlock Text="{Binding ScanText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <CheckBox Style="{StaticResource ThemedCheckBox}" Content="Tự động quét (30 giây)" IsChecked="{Binding Shell.AutoScan}" FontSize="11.5" Margin="0,0,0,4" />
                            <CheckBox Style="{StaticResource ThemedCheckBox}" Content="Tăng tốc ×10" IsChecked="{Binding Shell.SpeedUp}" FontSize="11.5" />
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="ĐIỀU HÀNH" Style="{StaticResource Overline}" Margin="12,0,0,8" />
                        <ListBox ItemsSource="{Binding NavItems}" SelectedIndex="{Binding PageIndex, Mode=TwoWay}"
                                 PreviewMouseLeftButtonUp="NavList_PreviewMouseLeftButtonUp"
                                 ItemContainerStyle="{StaticResource NavItem}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <Border Grid.Column="2" Background="{DynamicResource Primary}" CornerRadius="9" MinWidth="20" Padding="6,1"
                                                Visibility="{Binding BadgeVisibility}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="PHÂN TÍCH" Style="{StaticResource Overline}" Margin="12,14,0,8" />
                        <Button x:Name="WhatIfNavButton" Click="WhatIf_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                ToolTip="Mở mô phỏng What-if ngay trong cửa sổ này">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                        </Trigger>
                                        <!-- Đang mở trang What-if trong cửa sổ: tô nền như mục đang chọn. -->
                                        <Trigger Property="Tag" Value="Active">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource Text2}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Mô phỏng What-if" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" />
                                    <TextBlock Text="5 kịch bản · gợi ý điều phối" FontSize="10.5" Foreground="{DynamicResource Text2}" Opacity="0.8" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- PAGES -->
            <Grid Grid.Column="1" x:Name="PagesHost">

                <!-- ===== Trang 0: Tổng quan mạng lưới ===== -->
                <views:OverviewPage DataContext="{Binding Overview}" Visibility="{Binding DataContext.OverviewVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                <!-- ===== Trang 1: Sự cố & bảo trì (UC-OP-03) ===== -->
                <views:IncidentsPage DataContext="{Binding Incidents}" Visibility="{Binding DataContext.IncidentsVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                <!-- ===== Trang 2: Phương tiện & cổng sạc ===== -->
                <views:AssetsPage DataContext="{Binding Assets}" Visibility="{Binding DataContext.AssetsVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                <!-- ===== Trang 3: Lịch sạc thông minh (UC-SYS-01 / UC-OP-04) ===== -->
                <views:ChargingPage DataContext="{Binding Charging}" Visibility="{Binding DataContext.ChargingVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                <!-- ===== Trang 4: Điều phối phương tiện ===== -->
                <views:DispatchPage DataContext="{Binding Dispatch}" Visibility="{Binding DataContext.DispatchVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                <!-- ===== Trang 5: Kịch bản demo & nhật ký ===== -->
                <views:DemoLogPage DataContext="{Binding Demo}" Visibility="{Binding DataContext.DemoVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>

            <!-- ===== Mô phỏng What-if (UC-OP-05): mở ngay trong cửa sổ, che vùng trang khi đang xem ===== -->
            <ContentControl Grid.Column="1" x:Name="WhatIfHost" Visibility="Collapsed" Focusable="False" />
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#0F172A" Padding="18,7">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Shell.LastActionText}" Foreground="#E2E8F0" FontSize="11.5" />
                </StackPanel>
                <TextBlock Text="Nhóm 21 · CO3001 · Dữ liệu mô phỏng" Foreground="#64748B" FontSize="11"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
