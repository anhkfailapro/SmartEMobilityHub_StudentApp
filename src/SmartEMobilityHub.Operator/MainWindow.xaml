                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Khoá thiết bị" Style="{StaticResource PrimaryButton}"
                                        Click="Lock_Click" IsEnabled="{Binding CanLock}" Margin="0,0,8,8" />
                                <Button Content="Tạo phiếu bảo trì" Style="{StaticResource GhostButton}"
                                        Click="Task_Click" IsEnabled="{Binding CanCreateTask}" Margin="0,0,8,8" />
                                <Button Content="Gán KTV gần nhất" Style="{StaticResource GhostButton}"
                                        Click="Assign_Click" IsEnabled="{Binding CanAssign}" Margin="0,0,8,8" />
                                <Button Content="Hoàn tất xử lý" Style="{StaticResource GhostButton}"
                                        Click="Resolve_Click" IsEnabled="{Binding CanResolve}" Margin="0,0,8,8" />
                                <Button Content="Đóng sự cố" Style="{StaticResource GhostButton}"
                                        Click="Close_Click" IsEnabled="{Binding CanClose}" Margin="0,0,8,8" />
                                <Button Content="Tạm dừng Hub" Style="{StaticResource GhostButton}"
                                        Foreground="{DynamicResource Danger}" Click="Suspend_Click"
                                        IsEnabled="{Binding CanSuspend}" Margin="0,0,8,8" />
                                <Button Content="Mở lại Hub" Style="{StaticResource GhostButton}"
                                        Click="Resume_Click" IsEnabled="{Binding CanResume}" Margin="0,0,0,8" />
                            </WrapPanel>

                            <TextBlock Text="Phiếu bảo trì" Style="{StaticResource H2}" Margin="0,12,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAlt}"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TaskId}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding TechText}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding SlaText}" FontSize="11.5"
                                                               Foreground="{Binding SlaBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Nhật ký xử lý" Style="{StaticResource H2}" Margin="0,12,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedIncident.Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" />
                                            <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{DynamicResource Primary}"
                                                     VerticalAlignment="Top" Margin="0,4,0,0" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
                                                <TextBlock Text="{Binding Actor}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding EmptyVisibility}">
                        <TextBlock Text="Chọn một sự cố ở cột bên trái" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyHintText}"
                                   Style="{StaticResource Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Tình trạng xử lý" Style="{StaticResource H2}" />
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <Border Background="{DynamicResource AmberSubtle}" CornerRadius="10" Padding="10" Margin="0,0,4,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding KpiNew}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AmberText}" />
                                            <TextBlock Text="Mới" FontSize="11" Foreground="{DynamicResource AmberText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource SkySubtle}" CornerRadius="10" Padding="10" Margin="4,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding KpiCheck}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SkyText}" />
                                            <TextBlock Text="Kiểm tra / khoá" FontSize="11" Foreground="{DynamicResource SkyText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource VioletSubtle}" CornerRadius="10" Padding="10" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding KpiRepair}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource VioletText}" />
                                            <TextBlock Text="Đang sửa" FontSize="11" Foreground="{DynamicResource VioletText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource EmeraldSubtle}" CornerRadius="10" Padding="10" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding KpiDone}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource EmeraldText}" />
                                            <TextBlock Text="Đã xong" FontSize="11" Foreground="{DynamicResource EmeraldText}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="Kỹ thuật viên" Style="{StaticResource H2}" Margin="0,16,0,2" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8">
                                    <Run Text="{Binding TechText, Mode=OneWay}" /><Run Text=" đang sẵn sàng · khoảng cách tới Hub của sự cố" />
                                </TextBlock>
                        <ItemsControl ItemsSource="{Binding Technicians}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{Binding AvailableBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                            <TextBlock Text="{Binding Team}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding AvailableText}" FontSize="11" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding DistanceText}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== Trang 2: Phương tiện & cổng sạc ===== -->
                <Grid Margin="22,18,22,16" Visibility="{Binding AssetsVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Phương tiện &amp; cổng sạc" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding AssetSummaryText}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding AssetHubOptions}"
                                  SelectedItem="{Binding AssetHubFilter, Mode=TwoWay}" VerticalAlignment="Center" Height="34" FontSize="12.5" />
                        <ListBox Grid.Column="1" ItemsSource="{Binding VehicleFilters}" SelectedItem="{Binding SelectedVehicleFilter}"
                                 Style="{StaticResource ChipList}" Margin="12,6,12,0" VerticalAlignment="Center">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBox Grid.Column="2" Text="{Binding AssetSearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Tìm mã xe, mẫu xe, Hub…"
                                 Style="{StaticResource SearchBox}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="430" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="16,14,16,10">
                                    <StackPanel>
                                        <TextBlock Text="Giám sát phương tiện" Style="{StaticResource H1}" />
                                        <TextBlock Text="Trạng thái, mức pin và thời điểm cập nhật cảm biến của từng xe (dữ liệu quá 10 phút được tô cam)" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" Padding="16,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="MÃ XE" Style="{StaticResource Overline}" />
                                        <TextBlock Grid.Column="1" Text="LOẠI · MẪU" Style="{StaticResource Overline}" />
                                        <TextBlock Grid.Column="2" Text="HUB · VỊ TRÍ" Style="{StaticResource Overline}" />
                                        <TextBlock Grid.Column="3" Text="MỨC PIN" Style="{StaticResource Overline}" />
                                        <TextBlock Grid.Column="4" Text="TRẠNG THÁI" Style="{StaticResource Overline}" />
                                        <TextBlock Grid.Column="5" Text="CẬP NHẬT" Style="{StaticResource Overline}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Grid>
                                    <ListBox ItemsSource="{Binding VehicleRows}" ItemContainerStyle="{StaticResource QueueItem}" BorderThickness="0"
                                             Background="Transparent" HorizontalContentAlignment="Stretch" Padding="10,4"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="118" />
                                                        <ColumnDefinition Width="96" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ConnectionGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                   Foreground="{Binding ConnectionBrush}" ToolTip="{Binding ConnectionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Code}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="12" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding HubText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SlotText}" Style="{StaticResource Caption}" FontSize="10.5" />
                                                    </StackPanel>
                                                    <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="40" />
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding Battery, Mode=OneWay}" Foreground="{Binding BatteryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding BatteryText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <Border Grid.Column="4" Style="{StaticResource Pill}" Background="{Binding StatusBackground}" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusForeground}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="5" Text="{Binding UpdatedText}" FontSize="11.5" Foreground="{Binding UpdatedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Không có xe nào khớp bộ lọc." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding VehicleEmptyVisibility}" />
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14,6,6">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,10,10">
                                    <TextBlock Text="Cổng sạc theo Hub" Style="{StaticResource H1}" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource EmeraldSubtle}" Margin="0,0,6,4"><TextBlock Text="Trống" FontSize="10.5" Foreground="{DynamicResource EmeraldText}" /></Border>
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource VioletSubtle}" Margin="0,0,6,4"><TextBlock Text="Đang sạc" FontSize="10.5" Foreground="{DynamicResource VioletText}" /></Border>
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource SkySubtle}" Margin="0,0,6,4"><TextBlock Text="Đã cấp / kiểm tra" FontSize="10.5" Foreground="{DynamicResource SkyText}" /></Border>
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource RoseSubtle}" Margin="0,0,6,4"><TextBlock Text="Lỗi / khoá" FontSize="10.5" Foreground="{DynamicResource RoseText}" /></Border>
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource SurfaceAlt}" Margin="0,0,6,4"><TextBlock Text="Offline" FontSize="10.5" Foreground="{DynamicResource Text2}" /></Border>
                                    </WrapPanel>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding PortGroups}" Margin="0,0,10,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{Binding SummaryBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Ports}" ItemTemplate="{StaticResource PortTileTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Trang 3: Lịch sạc thông minh (UC-SYS-01 / UC-OP-04) ===== -->
                <Grid Margin="22,18,22,16" Visibility="{Binding ChargingVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Lịch sạc thông minh" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Ưu tiên xe pin thấp và xe sắp cần dùng, trong giới hạn công suất của Hub; cổng lỗi được tự chuyển xe sang cổng khác." Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Hàng chờ sạc" Style="{StaticResource H1}" />
                                            <TextBlock Text="{Binding ChargingSummaryText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,140,0" />
                                        </StackPanel>
                                        <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding HubIds}"
                                                  SelectedItem="{Binding ChargingHubId, Mode=TwoWay}"
                                                  Width="130" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12.5" />
                                    </Grid>
                                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,12,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="66" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="#" Style="{StaticResource Overline}" />
                                            <TextBlock Grid.Column="1" Text="XE" Style="{StaticResource Overline}" />
                                            <TextBlock Grid.Column="2" Text="PIN" Style="{StaticResource Overline}" />
                                            <TextBlock Grid.Column="3" Text="ĐIỂM" Style="{StaticResource Overline}" />
                                            <TextBlock Grid.Column="4" Text="CỔNG" Style="{StaticResource Overline}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                        <ListBox ItemsSource="{Binding ChargingQueue}"
                                 SelectedItem="{Binding SelectedQueueRow, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource QueueItem}"
                                 HorizontalContentAlignment="Stretch" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource Text}">
                            <!-- Không có ScrollViewer riêng: cuộn chuột trên hàng chờ vẫn cuộn cả cột. -->
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="66" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Vehicle}" FontSize="11.5" />
                                        <TextBlock Grid.Column="2" Text="{Binding BatteryText}" FontSize="11.5" />
                                        <TextBlock Grid.Column="3" Text="{Binding ScoreText}" FontSize="11.5"
                                                   Foreground="{DynamicResource Primary}" />
                                        <TextBlock Grid.Column="4" Text="{Binding StatusText}" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="▲ Ghim lên" Style="{StaticResource GhostButton}" Click="QueueUp_Click"
                                                IsEnabled="{Binding CanMoveQueueUp}" Margin="0,0,6,6" />
                                        <Button Content="▼ Ghim xuống" Style="{StaticResource GhostButton}" Click="QueueDown_Click"
                                                IsEnabled="{Binding CanMoveQueueDown}" Margin="0,0,6,6" />
                                        <Button Content="Lập lịch lại" Style="{StaticResource PrimaryButton}" Click="Reschedule_Click"
                                                Margin="0,0,6,6" />
                                        <Button Content="Thêm 3 yêu cầu sạc (HUB-08)" Style="{StaticResource GhostButton}"
                                                Click="ChargeDemo_Click" Margin="0,0,0,6" />
                                    </WrapPanel>

                                    <TextBlock Text="Cổng sạc của Hub" Style="{StaticResource H2}" Margin="0,14,0,4" />
                                    <TextBlock Text="{Binding ChargingHubPorts.SummaryText}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding ChargingHubPorts.Ports}" ItemTemplate="{StaticResource PortTileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
