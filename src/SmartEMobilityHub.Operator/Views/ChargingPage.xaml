<UserControl x:Class="SmartEMobilityHub.Operator.Views.ChargingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Trang "Lịch sạc thông minh (UC-SYS-01 / UC-OP-04)" của Trung tâm điều hành (tách từ MainWindow.xaml, DC-52).
         DataContext kế thừa từ cửa sổ (MainViewModel); nút bind vào lệnh, không có handler Click. -->
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Lịch sạc thông minh" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Ưu tiên xe pin thấp và xe sắp cần dùng, trong giới hạn công suất của Hub; cổng lỗi được tự chuyển xe sang cổng khác." Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Hàng chờ sạc" Style="{StaticResource H1}" />
                                <TextBlock Text="{Binding ChargingSummaryText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,140,0" />
                            </StackPanel>
                            <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding HubIds}"
                                      SelectedItem="{Binding ChargingHubId, Mode=TwoWay}"
                                      Width="130" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12.5" />
                        </Grid>
                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,12,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="66" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource Overline}" />
                                <TextBlock Grid.Column="1" Text="XE" Style="{StaticResource Overline}" />
                                <TextBlock Grid.Column="2" Text="PIN" Style="{StaticResource Overline}" />
                                <TextBlock Grid.Column="3" Text="ĐIỂM" Style="{StaticResource Overline}" />
                                <TextBlock Grid.Column="4" Text="CỔNG" Style="{StaticResource Overline}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
            <ListBox ItemsSource="{Binding ChargingQueue}"
                     SelectedItem="{Binding SelectedQueueRow, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource QueueItem}"
                     HorizontalContentAlignment="Stretch" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource Text}">
                <!-- Không có ScrollViewer riêng: cuộn chuột trên hàng chờ vẫn cuộn cả cột. -->
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="{Binding Vehicle}" FontSize="11.5" />
                            <TextBlock Grid.Column="2" Text="{Binding BatteryText}" FontSize="11.5" />
                            <TextBlock Grid.Column="3" Text="{Binding ScoreText}" FontSize="11.5"
                                       Foreground="{DynamicResource Primary}" />
                            <TextBlock Grid.Column="4" Text="{Binding StatusText}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="▲ Ghim lên" Style="{StaticResource GhostButton}" Command="{Binding QueueUpCommand}"
                                    IsEnabled="{Binding CanMoveQueueUp}" Margin="0,0,6,6" />
                            <Button Content="▼ Ghim xuống" Style="{StaticResource GhostButton}" Command="{Binding QueueDownCommand}"
                                    IsEnabled="{Binding CanMoveQueueDown}" Margin="0,0,6,6" />
                            <Button Content="Lập lịch lại" Style="{StaticResource PrimaryButton}" Command="{Binding RescheduleCommand}"
                                    Margin="0,0,6,6" />
                            <Button Content="Thêm 3 yêu cầu sạc (HUB-08)" Style="{StaticResource GhostButton}"
                                    Command="{Binding AddChargingRequestsCommand}" Margin="0,0,0,6" />
                        </WrapPanel>

                        <TextBlock Text="Cổng sạc của Hub" Style="{StaticResource H2}" Margin="0,14,0,4" />
                        <TextBlock Text="{Binding ChargingHubPorts.SummaryText}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding ChargingHubPorts.Ports}" ItemTemplate="{StaticResource PortTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Quy tắc ưu tiên" Style="{StaticResource H1}" />
                    <TextBlock Text="Điểm ưu tiên = pin thấp × w₁ + sắp cần xe × w₂ + cao điểm × w₃ (thang 0–100). Tổng trọng số phải bằng 1; giá trị sai bị từ chối và giữ trọng số cũ."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12" />
            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,2,0,0">
                <StackPanel>
                    <TextBlock Text="Quy tắc ưu tiên (tổng = 1)" FontSize="11.5" FontWeight="SemiBold" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Pin thấp" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding WeightBatteryText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sắp cần xe" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding WeightNeedTimeText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Cao điểm" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding WeightPeakText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding WeightsInfoText}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Áp dụng" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyWeightsCommand}" Margin="0,0,6,0" />
                        <Button Content="Mặc định" Style="{StaticResource GhostButton}"
                                Command="{Binding ResetWeightsCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>


                    <Border Background="{DynamicResource PrimarySubtle}" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Mẹo vận hành" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                            <TextBlock Text="• Chọn một yêu cầu đang chờ rồi Ghim lên/xuống để cố định thứ tự; yêu cầu đã ghim giữ chỗ khi lập lịch lại.&#x0a;• Cổng lỗi/offline không được cấp; xe đang sạc ở cổng lỗi được chuyển sang cổng khác."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
