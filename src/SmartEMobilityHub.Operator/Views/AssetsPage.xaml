<UserControl x:Class="SmartEMobilityHub.Operator.Views.AssetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Trang "Phương tiện &amp; cổng sạc" của Trung tâm điều hành (tách từ MainWindow.xaml, DC-52).
         DataContext là AssetsPageViewModel (MainWindow gán); nút bind vào lệnh, không có handler Click. -->
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Phương tiện &amp; cổng sạc" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding AssetSummaryText}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding AssetHubOptions}"
                      SelectedItem="{Binding AssetHubFilter, Mode=TwoWay}" VerticalAlignment="Center" Height="34" FontSize="12.5" />
            <ListBox Grid.Column="1" ItemsSource="{Binding VehicleFilters}" SelectedItem="{Binding SelectedVehicleFilter}"
                     Style="{StaticResource ChipList}" Margin="12,6,12,0" VerticalAlignment="Center">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" FontSize="12"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBox Grid.Column="2" Text="{Binding AssetSearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Tìm mã xe, mẫu xe, Hub…"
                     Style="{StaticResource SearchBox}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,14,16,10">
                        <StackPanel>
                            <TextBlock Text="Giám sát phương tiện" Style="{StaticResource H1}" />
                            <TextBlock Text="Trạng thái, mức pin và thời điểm cập nhật cảm biến của từng xe (dữ liệu quá 10 phút được tô cam)" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MÃ XE" Style="{StaticResource Overline}" />
                            <TextBlock Grid.Column="1" Text="LOẠI · MẪU" Style="{StaticResource Overline}" />
                            <TextBlock Grid.Column="2" Text="HUB · VỊ TRÍ" Style="{StaticResource Overline}" />
                            <TextBlock Grid.Column="3" Text="MỨC PIN" Style="{StaticResource Overline}" />
                            <TextBlock Grid.Column="4" Text="TRẠNG THÁI" Style="{StaticResource Overline}" />
                            <TextBlock Grid.Column="5" Text="CẬP NHẬT" Style="{StaticResource Overline}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <Grid>
                        <ListBox ItemsSource="{Binding VehicleRows}" ItemContainerStyle="{StaticResource QueueItem}" BorderThickness="0"
                                 Background="Transparent" HorizontalContentAlignment="Stretch" Padding="10,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ConnectionGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Foreground="{Binding ConnectionBrush}" ToolTip="{Binding ConnectionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Code}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="12" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HubText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SlotText}" Style="{StaticResource Caption}" FontSize="10.5" />
                                        </StackPanel>
                                        <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Style="{StaticResource Meter}" Value="{Binding Battery, Mode=OneWay}" Foreground="{Binding BatteryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding BatteryText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Grid.Column="4" Style="{StaticResource Pill}" Background="{Binding StatusBackground}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusForeground}" />
                                        </Border>
                                        <TextBlock Grid.Column="5" Text="{Binding UpdatedText}" FontSize="11.5" Foreground="{Binding UpdatedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Không có xe nào khớp bộ lọc." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding VehicleEmptyVisibility}" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14,6,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,10,10">
                        <TextBlock Text="Cổng sạc theo Hub" Style="{StaticResource H1}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource EmeraldSubtle}" Margin="0,0,6,4"><TextBlock Text="Trống" FontSize="10.5" Foreground="{DynamicResource EmeraldText}" /></Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource VioletSubtle}" Margin="0,0,6,4"><TextBlock Text="Đang sạc" FontSize="10.5" Foreground="{DynamicResource VioletText}" /></Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource SkySubtle}" Margin="0,0,6,4"><TextBlock Text="Đã cấp / kiểm tra" FontSize="10.5" Foreground="{DynamicResource SkyText}" /></Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource RoseSubtle}" Margin="0,0,6,4"><TextBlock Text="Lỗi / khoá" FontSize="10.5" Foreground="{DynamicResource RoseText}" /></Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource SurfaceAlt}" Margin="0,0,6,4"><TextBlock Text="Offline" FontSize="10.5" Foreground="{DynamicResource Text2}" /></Border>
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PortGroups}" Margin="0,0,10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{Binding SummaryBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Ports}" ItemTemplate="{StaticResource PortTileTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
