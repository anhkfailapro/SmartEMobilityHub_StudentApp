<UserControl x:Class="SmartEMobilityHub.Operator.Views.DispatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Trang "Điều phối phương tiện" của Trung tâm điều hành (tách từ MainWindow.xaml, DC-52).
         DataContext là DispatchPageViewModel (MainWindow gán); nút bind vào lệnh, không có handler Click. -->
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Điều phối phương tiện" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Phát hiện Hub dư xe (≥ 85%) và thiếu xe (≤ 35%), gợi ý lệnh điều chuyển về mức mục tiêu 65%; chỉ dùng xe thật đang sẵn sàng." Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="16,14,6,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Cân bằng tải giữa các Hub" Style="{StaticResource H1}" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Hubs}" Margin="0,0,10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource Pill}" Background="{Binding ImbalanceBackground}" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding ImbalanceTag}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ImbalanceBrush}" />
                                                </Border>
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Style="{StaticResource Meter}" Value="{Binding ParkingPercent, Mode=OneWay}" Foreground="{Binding ParkingBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ParkingText}" FontSize="11" Foreground="{DynamicResource Text2}" Margin="10,0,0,0" />
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{Binding VehiclesText}" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{Binding FreeSlotsText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Lệnh điều phối" Style="{StaticResource H1}" Margin="0,0,0,10" />
                    </StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Hub nguồn" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                            <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding HubIds}" SelectedItem="{Binding SourceHubId, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hub đích" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                            <ComboBox Style="{StaticResource ThemedComboBox}" ItemsSource="{Binding HubIds}" SelectedItem="{Binding TargetHubId, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số xe" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding DispatchVehicleCountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nhân sự" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding DispatchStaffId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Gợi ý tự động" Style="{StaticResource GhostButton}"
                                Command="{Binding SuggestDispatchCommand}" Margin="0,0,6,6" />
                        <Button Content="Tạo lệnh" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateDispatchCommand}" Margin="0,0,6,6" />
                        <Button Content="Xuất phát" Style="{StaticResource GhostButton}"
                                Command="{Binding ExecuteDispatchCommand}" IsEnabled="{Binding CanExecuteDispatch}" Margin="0,0,6,6" />
                        <Button Content="Hoàn tất" Style="{StaticResource GhostButton}"
                                Command="{Binding CompleteDispatchCommand}" IsEnabled="{Binding CanCompleteDispatch}" Margin="0,0,0,6" />
                    </WrapPanel>

                    <ListBox ItemsSource="{Binding DispatchOrders}"
                            SelectedItem="{Binding SelectedDispatchOrder, Mode=TwoWay}"
                            HorizontalContentAlignment="Stretch"
                            BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,4">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding OrderId}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding RouteText}" FontSize="11.5" FontWeight="SemiBold"
                                                    Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold"
                                                    Foreground="{Binding StatusBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{Binding VehiclesText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>


</ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
