<UserControl x:Class="SmartEMobilityHub.Operator.Views.IncidentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Trang "Sự cố &amp; bảo trì (UC-OP-03)" của Trung tâm điều hành (tách từ MainWindow.xaml, DC-52).
         DataContext kế thừa từ cửa sổ (MainViewModel); nút bind vào lệnh, không có handler Click. -->
    <Grid Margin="22,18,22,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Grid>
                        <TextBlock Text="Sự cố &amp; Bảo trì" Style="{StaticResource H1}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="10" Padding="8,3">
                            <TextBlock Text="{Binding VisibleCountText}" Style="{StaticResource Caption}" />
                        </Border>
                    </Grid>

                    <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                             Style="{StaticResource ChipList}" Margin="0,10,0,6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Tìm mã, thiết bị, lỗi hoặc Hub…"
                             Style="{StaticResource SearchBox}" Margin="0,0,0,10" />
                </StackPanel>
        <ListBox ItemsSource="{Binding Incidents}"
                 SelectedItem="{Binding SelectedIncident, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource IncidentItem}"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="False">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding PriorityBrush}" Width="4" CornerRadius="2"
                                Margin="0,2,0,2" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Grid>
                                <TextBlock Text="{Binding Code}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}" />
                                <Border HorizontalAlignment="Right" Background="{Binding StatusBackground}"
                                        CornerRadius="8" Padding="7,2">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                                               Foreground="{Binding StatusForeground}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text}" Margin="0,3,0,0" />
                            <Grid Margin="0,5,0,0">
                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PriorityText}" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{Binding PriorityBrush}"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding CreatedText}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,14,0">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DetailVisibility}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedIncident.Title}" Style="{StaticResource H1}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedIncident.Meta}" Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SelectedIncident.Id}" Style="{StaticResource Caption}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                Margin="10,0,0,0">
                        <Border Background="{Binding SelectedIncident.PriorityBrush}" CornerRadius="10"
                                Padding="9,3" Margin="0,0,6,0">
                            <TextBlock Text="{Binding SelectedIncident.PriorityText}" Foreground="White"
                                       FontSize="11" />
                        </Border>
                        <Border Background="{Binding SelectedIncident.StatusBackground}" CornerRadius="10"
                                Padding="9,3">
                            <TextBlock Text="{Binding SelectedIncident.StatusText}"
                                       Foreground="{Binding SelectedIncident.StatusForeground}" FontSize="11" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedIncident.Description}" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="{DynamicResource Text}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}">
                            <Run Text="Người báo: " />
                            <Run Text="{Binding SelectedIncident.ReporterText, Mode=OneWay}" />
                            <Run Text="  ·  Tạo: " />
                            <Run Text="{Binding SelectedIncident.CreatedText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,14,0,0">
                    <Button Content="Khoá thiết bị" Style="{StaticResource PrimaryButton}"
                            Command="{Binding LockCommand}" IsEnabled="{Binding CanLock}" Margin="0,0,8,8" />
                    <Button Content="Tạo phiếu bảo trì" Style="{StaticResource GhostButton}"
                            Command="{Binding CreateTaskCommand}" IsEnabled="{Binding CanCreateTask}" Margin="0,0,8,8" />
                    <Button Content="Gán KTV gần nhất" Style="{StaticResource GhostButton}"
                            Command="{Binding AssignCommand}" IsEnabled="{Binding CanAssign}" Margin="0,0,8,8" />
                    <Button Content="Hoàn tất xử lý" Style="{StaticResource GhostButton}"
                            Command="{Binding ResolveCommand}" IsEnabled="{Binding CanResolve}" Margin="0,0,8,8" />
                    <Button Content="Đóng sự cố" Style="{StaticResource GhostButton}"
                            Command="{Binding CloseIncidentCommand}" IsEnabled="{Binding CanClose}" Margin="0,0,8,8" />
                    <Button Content="Tạm dừng Hub" Style="{StaticResource GhostButton}"
                            Foreground="{DynamicResource Danger}" Command="{Binding SuspendHubCommand}"
                            IsEnabled="{Binding CanSuspend}" Margin="0,0,8,8" />
                    <Button Content="Mở lại Hub" Style="{StaticResource GhostButton}"
                            Command="{Binding ResumeHubCommand}" IsEnabled="{Binding CanResume}" Margin="0,0,0,8" />
                </WrapPanel>

                <TextBlock Text="Phiếu bảo trì" Style="{StaticResource H2}" Margin="0,12,0,6" />
                <ItemsControl ItemsSource="{Binding SelectedTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TaskId}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TechText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding SlaText}" FontSize="11.5"
                                                   Foreground="{Binding SlaBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Nhật ký xử lý" Style="{StaticResource H2}" Margin="0,12,0,6" />
                <ItemsControl ItemsSource="{Binding SelectedIncident.Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" />
                                <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{DynamicResource Primary}"
                                         VerticalAlignment="Top" Margin="0,4,0,0" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
                                    <TextBlock Text="{Binding Actor}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding EmptyVisibility}">
            <TextBlock Text="Chọn một sự cố ở cột bên trái" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyHintText}"
                       Style="{StaticResource Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>

        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Tình trạng xử lý" Style="{StaticResource H2}" />
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Border Background="{DynamicResource AmberSubtle}" CornerRadius="10" Padding="10" Margin="0,0,4,8">
                            <StackPanel>
                                <TextBlock Text="{Binding KpiNew}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AmberText}" />
                                <TextBlock Text="Mới" FontSize="11" Foreground="{DynamicResource AmberText}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SkySubtle}" CornerRadius="10" Padding="10" Margin="4,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding KpiCheck}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SkyText}" />
                                <TextBlock Text="Kiểm tra / khoá" FontSize="11" Foreground="{DynamicResource SkyText}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource VioletSubtle}" CornerRadius="10" Padding="10" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{Binding KpiRepair}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource VioletText}" />
                                <TextBlock Text="Đang sửa" FontSize="11" Foreground="{DynamicResource VioletText}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource EmeraldSubtle}" CornerRadius="10" Padding="10" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding KpiDone}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource EmeraldText}" />
                                <TextBlock Text="Đã xong" FontSize="11" Foreground="{DynamicResource EmeraldText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="Kỹ thuật viên" Style="{StaticResource H2}" Margin="0,16,0,2" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8">
                        <Run Text="{Binding TechText, Mode=OneWay}" /><Run Text=" đang sẵn sàng · khoảng cách tới Hub của sự cố" />
                    </TextBlock>
            <ItemsControl ItemsSource="{Binding Technicians}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" Fill="{Binding AvailableBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                <TextBlock Text="{Binding Team}" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding AvailableText}" FontSize="11" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding DistanceText}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
