<Window x:Class="SmartEMobilityHub.Operator.WhatIfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mô phỏng và phân tích kịch bản · Trung tâm điều hành"
        Height="900" Width="1480" MinHeight="760" MinWidth="1160"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        FontFamily="Segoe UI, Roboto, sans-serif">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="ScenarioInput" TargetType="Control">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE3EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource H2}">
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <Style x:Key="NavItem" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar follows the Figma operator dashboard navigation. -->
        <Border Grid.Column="0" Background="#203D87">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,2,0,28">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#FFFFFF" Margin="0,0,9,0">
                        <TextBlock Text="⚡" Foreground="#2563EB" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Smart E-Mobility" Foreground="White" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Hub" Foreground="#DCE8FF" FontSize="10" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="ĐIỀU HÀNH TRUNG TÂM" Foreground="#AFC4F4"
                           FontSize="9" FontWeight="Bold" Margin="7,0,0,8" />
                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Width="24" Foreground="#DCE8FF" FontSize="14" />
                            <TextBlock Text="Quản lý sự cố &amp; Hub" Foreground="#DCE8FF" FontSize="11.5" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◷" Width="24" Foreground="#DCE8FF" FontSize="14" />
                            <TextBlock Text="Giám sát trạng thái &amp; lịch trình" Foreground="#DCE8FF" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚒" Width="24" Foreground="#DCE8FF" FontSize="14" />
                            <TextBlock Text="Xử lý &amp; bảo trì" Foreground="#DCE8FF" FontSize="11.5" />
                        </StackPanel>
                    </Border>
                    <Border Background="#3158B4" Style="{StaticResource NavItem}" Margin="0,4,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◈" Width="24" Foreground="White" FontSize="14" />
                            <TextBlock Text="Mô phỏng &amp; phân tích kịch bản" Foreground="White"
                                       FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌁" Width="24" Foreground="#DCE8FF" FontSize="14" />
                            <TextBlock Text="Báo cáo &amp; thống kê" Foreground="#DCE8FF" FontSize="11.5" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Border Background="#294A99" CornerRadius="8" Padding="10" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="◉  Hệ thống đang hoạt động" Foreground="#DCE8FF"
                                       FontSize="10.5" FontWeight="SemiBold" />
                            <TextBlock Text="12 Hub · Kết nối ổn định" Foreground="#B9CCF5"
                                       FontSize="9.5" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#5670AE" BorderThickness="0,1,0,0" Padding="2,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#DCE8FF" Margin="0,0,8,0">
                                <TextBlock Text="ĐP" Foreground="#203D87" FontWeight="Bold" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Minh Đức" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                                <TextBlock Text="Điều phối viên" Foreground="#B9CCF5" FontSize="9.5" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="22,17,22,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="2,0,2,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Mô phỏng và phân tích kịch bản" FontSize="21" FontWeight="Bold"
                               Foreground="#172554" />
                    <TextBlock Text="Phân tích tác động và đề xuất phương án điều phối cho toàn mạng lưới."
                               FontSize="11.5" Foreground="#718096" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="UC-WI-01 → UC-WI-05" FontSize="10" Foreground="#64748B"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="← Quay lại" Style="{StaticResource GhostButton}" Click="Close_Click"
                            Padding="11,6" />
                </StackPanel>
            </Grid>

            <!-- Summary cards mirror the four compact KPI tiles in Figma. -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="BƯỚC DỰ BÁO" FontSize="9.5" Foreground="#718096" FontWeight="Bold" />
                            <TextBlock Text="{Binding Forecast.Count}" FontSize="21" FontWeight="Bold"
                                       Foreground="#172554" Margin="0,3,0,0" />
                            <TextBlock Text="mốc thời gian" FontSize="9.5" Foreground="#94A3B8" />
                        </StackPanel>
                        <Border Width="28" Height="28" CornerRadius="7" Background="#EFF6FF"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="◷" Foreground="#2563EB" FontSize="16" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="HUB BỊ ẢNH HƯỞNG" FontSize="9.5" Foreground="#718096" FontWeight="Bold" />
                            <TextBlock Text="{Binding AffectedHubCount}" FontSize="21" FontWeight="Bold"
                                       Foreground="#172554" Margin="0,3,0,0" />
                            <TextBlock Text="trong mạng lưới" FontSize="9.5" Foreground="#94A3B8" />
                        </StackPanel>
                        <Border Width="28" Height="28" CornerRadius="7" Background="#F1F5F9"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="⌖" Foreground="#475569" FontSize="17" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="PHƯƠNG ÁN ĐỀ XUẤT" FontSize="9.5" Foreground="#718096" FontWeight="Bold" />
                            <TextBlock Text="{Binding Recommendations.Count}" FontSize="21" FontWeight="Bold"
                                       Foreground="#172554" Margin="0,3,0,0" />
                            <TextBlock Text="có thể mô phỏng lại" FontSize="9.5" Foreground="#94A3B8" />
                        </StackPanel>
                        <Border Width="28" Height="28" CornerRadius="7" Background="#F5F3FF"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="◇" Foreground="#7C3AED" FontSize="17" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="CẢNH BÁO QUÁ TẢI" FontSize="9.5" Foreground="#718096" FontWeight="Bold" />
                            <TextBlock Text="{Binding CriticalHubCount}" FontSize="21" FontWeight="Bold"
                                       Foreground="#DC2626" Margin="0,3,0,0" />
                            <TextBlock Text="Hub vượt sức chứa" FontSize="9.5" Foreground="#94A3B8" />
                        </StackPanel>
                        <Border Width="28" Height="28" CornerRadius="7" Background="#FEF2F2"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="△" Foreground="#DC2626" FontSize="15" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Scenario setup -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="17">
                        <StackPanel>
                            <TextBlock Text="Xác định kịch bản mô phỏng" Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,15" />
                            <TextBlock Text="Kịch bản mô phỏng" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource ScenarioInput}" ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" />
                            <TextBlock Text="{Binding SelectedPreset.Description}" FontSize="10"
                                       Foreground="#8995A8" TextWrapping="Wrap" Margin="1,5,0,0" />

                            <TextBlock Text="Hub mô phỏng" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" />
                            <ComboBox Style="{StaticResource ScenarioInput}" ItemsSource="{Binding Hubs}"
                                      SelectedItem="{Binding SelectedHub}" DisplayMemberPath="Name" />

                            <Grid Margin="0,15,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mức tăng nhu cầu" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DemandSurgeText, StringFormat={}{0}%}"
                                           Foreground="#2563EB" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <TextBox Style="{StaticResource ScenarioInput}"
                                     Text="{Binding DemandSurgeText, UpdateSourceTrigger=PropertyChanged}" />
                            <Slider Minimum="-50" Maximum="200" Value="{Binding DemandSurgeText, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,5,0,0" Height="20" Foreground="#2563EB" />
                            <Grid Margin="0,0,0,0">
                                <TextBlock Text="−50%" FontSize="9" Foreground="#94A3B8" />
                                <TextBlock Text="+200%" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock Text="Khung thời gian phân tích" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                            <Border Background="#F8FAFC" BorderBrush="#DCE3EF" BorderThickness="1"
                                    CornerRadius="7" Padding="9,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="11.5" />
                                    <TextBlock Grid.Column="1" Text="—" Foreground="#94A3B8"
                                               VerticalAlignment="Center" Margin="5,0" />
                                    <TextBox Grid.Column="2" Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="11.5" />
                                    <TextBlock Grid.Column="2" Text="▣" Foreground="#60A5FA" HorizontalAlignment="Right"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Bước (phút)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource ScenarioInput}"
                                             Text="{Binding TimeStepText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Cổng sạc hỏng" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource ScenarioInput}"
                                             Text="{Binding DisabledChargerText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding ErrorText}" Foreground="#B91C1C" FontSize="10.5"
                                       TextWrapping="Wrap" Margin="0,9,0,0" />
                            <Button Content="Chạy mô phỏng" Style="{StaticResource PrimaryButton}"
                                    Click="Run_Click" IsEnabled="{Binding CanRun}" HorizontalAlignment="Stretch"
                                    Margin="0,15,0,0" Padding="14,10" />
                            <Button Content="Hủy thiết lập" Style="{StaticResource GhostButton}"
                                    Click="Cancel_Click" HorizontalAlignment="Stretch" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Results, forecast, warnings and recommendations -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kết quả mô phỏng" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding RunLabel}" FontSize="9.5" Foreground="#94A3B8"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Height="172">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="0,5,0,22">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="100%" FontSize="8.5" Foreground="#94A3B8" />
                                        <TextBlock Grid.Row="1" Text="75%" FontSize="8.5" Foreground="#94A3B8" />
                                        <TextBlock Grid.Row="2" Text="50%" FontSize="8.5" Foreground="#94A3B8" />
                                        <TextBlock Grid.Row="3" Text="25%" FontSize="8.5" Foreground="#94A3B8" />
                                    </Grid>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Forecast}" VerticalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid VerticalAlignment="Bottom" Height="137">
                                                        <Border Height="1" Background="#E8EDF5" VerticalAlignment="Top" />
                                                        <Border Height="1" Background="#E8EDF5" VerticalAlignment="Center" />
                                                        <Border Height="1" Background="#E8EDF5" VerticalAlignment="Bottom" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                                    VerticalAlignment="Bottom" Height="132">
                                                            <ProgressBar Width="13" Height="132" Orientation="Vertical"
                                                                         Minimum="0" Maximum="1"
                                                                         Value="{Binding ParkingUtilization}"
                                                                         Foreground="#8B83E8" Background="Transparent"
                                                                         BorderThickness="0" VerticalAlignment="Bottom" />
                                                            <ProgressBar Width="13" Height="132" Orientation="Vertical"
                                                                         Minimum="0" Maximum="1"
                                                                         Value="{Binding ChargingUtilization}"
                                                                         Foreground="#B8C4F3" Background="Transparent"
                                                                         BorderThickness="0" VerticalAlignment="Bottom" Margin="3,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding At, StringFormat=HH:mm}"
                                                               FontSize="8.5" Foreground="#64748B"
                                                               HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#8B83E8" Margin="0,0,5,0" />
                                    <TextBlock Text="Sử dụng bãi đỗ" FontSize="9" Foreground="#64748B" Margin="0,0,14,0" />
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#B8C4F3" Margin="0,0,5,0" />
                                    <TextBlock Text="Sử dụng cổng sạc" FontSize="9" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF1F0" BorderBrush="#F6B6B3" BorderThickness="1"
                                CornerRadius="8" Padding="11,9" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="△" FontSize="15" Foreground="#DC2626" Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="#9F2929"
                                           FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="15,13" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Phương án điều phối đề xuất" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Recommendations.Count, StringFormat={}{0} phương án}"
                                               FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Recommendations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,7" Margin="0,0,0,5"
                                                    Background="#FFFFFF" BorderBrush="#E7ECF4" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="▶" FontSize="9" Foreground="#334155"
                                                               VerticalAlignment="Top" Margin="0,3,7,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="#263449" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Description}" FontSize="9.5"
                                                                   Foreground="#718096" TextWrapping="Wrap" Margin="0,2,4,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Mô phỏng" Tag="{Binding Id}"
                                                            Click="ApplyRecommendation_Click" Style="{StaticResource GhostButton}"
                                                            Padding="8,5" FontSize="9.5" Margin="8,0,0,0"
                                                            VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding AffectedHubCount, StringFormat=Hub ảnh hưởng: {0}}"
                                           FontSize="9.5" Foreground="#718096" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="15,13" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="So sánh trước và sau mô phỏng" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Đỗ xe · Sạc · Xe khả dụng" FontSize="9" Foreground="#94A3B8"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Impacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="145" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding HubName}" FontSize="10" Foreground="#334155"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="1" Margin="10,0">
                                                    <ProgressBar Height="6" Maximum="1" Value="{Binding ParkingUtilizationBefore}"
                                                                 Foreground="#9BB7F0" Background="#EEF2F7" BorderThickness="0" />
                                                    <ProgressBar Height="6" Maximum="1" Margin="0,4,0,0"
                                                                 Value="{Binding ParkingUtilizationAfter}"
                                                                 Foreground="#8B83E8" Background="#EEF2F7" BorderThickness="0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ParkingUtilizationAfter, StringFormat=P0}"
                                                           FontSize="9.5" Foreground="#5B54C7" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Lịch sử phiên mô phỏng" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Chạy lại phiên mới" Style="{StaticResource GhostButton}"
                                        Click="Rerun_Click" Margin="0,0,7,0" Padding="9,6" FontSize="10" />
                                <Button Content="Xuất báo cáo" Style="{StaticResource PrimaryButton}"
                                        Click="Export_Click" Padding="10,6" FontSize="10" />
                            </StackPanel>
                        </Grid>
                        <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistorySession}"
                                  Padding="8" FontSize="10.5" Margin="0,0,0,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Preset.Name}" />
                                        <TextBlock Text="  ·  " />
                                        <TextBlock Text="{Binding SessionId}" Foreground="#64748B" />
                                        <TextBlock Text="  ·  " />
                                        <TextBlock Text="{Binding Runs.Count, StringFormat={}{0} lần chạy}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="7" Padding="10,7" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" Foreground="#526176" FontSize="10.5"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding DurationText, StringFormat=Thời gian chạy: {0}}"
                               Foreground="#94A3B8" FontSize="9.5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
